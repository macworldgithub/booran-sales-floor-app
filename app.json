{
  "expo": {
    "name": "Booran Sales Floor",
    "slug": "booran-sales-floor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/booran-icon-512.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171b22",
    "plugins": [
      ["expo-image-picker", { "photosPermission": "Allow Booran Sales Floor to attach customer photos and videos.", "cameraPermission": "Allow Booran Sales Floor to capture vehicle inspection and completion photos.", "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "Allow Booran Sales Floor to verify your dealership check-in and accessory completion." }],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.booran.salesfloor"
    },
    "android": {
      "package": "com.booran.salesfloor",
      "adaptiveIcon": {
        "backgroundColor": "#171b22",
        "foregroundImage": "./assets/images/booran-icon-192.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/booran-favicon-32.png"
    }
  }
}
