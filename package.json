{
  "name": "booran-sales-floor-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs",
    "start": "expo start",
    "preandroid": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "preios": "expo prebuild --platform ios --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "expo lint"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
